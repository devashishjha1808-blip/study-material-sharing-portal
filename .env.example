# ===================================================================
# Study Material Sharing Portal - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ===================================================================

# ----------------- Spring Boot Backend Configuration -----------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (dev uses H2 in-memory by default)
# For MySQL production:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studymaterial_db
DB_USER=root
DB_PASSWORD=your_secure_db_password_here

# JWT Security Configuration (Use 256-bit / 32-char minimum secret)
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_complex_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=30MB

# ----------------- Frontend Configuration (React / Vite) -------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME="CampusHub - Study Material Portal"
VITE_ENABLE_MOCK_FALLBACK=true

# ----------------- Mobile Configuration (Flutter) --------------------
API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:8080/api
API_BASE_URL_IOS_SIMULATOR=http://localhost:8080/api
API_BASE_URL_PHYSICAL_DEVICE=http://192.168.1.100:8080/api

# Firebase Configuration Placeholders (Experiment 14)
# Keep actual serviceAccountKey.json and google-services.json in .gitignore
FIREBASE_API_KEY=AIzaSyDummyKeyForTemplatePurposesOnly12345
FIREBASE_AUTH_DOMAIN=campus-study-portal.firebaseapp.com
FIREBASE_PROJECT_ID=campus-study-portal
FIREBASE_STORAGE_BUCKET=campus-study-portal.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
